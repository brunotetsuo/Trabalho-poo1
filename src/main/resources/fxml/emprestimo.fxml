<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="1000.0" styleClass="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.aula.controller.EmprestimoController">

    <center>

        <HBox alignment="CENTER" spacing="30" styleClass="container-principal">

            <!-- FORMULARIO -->
            <VBox alignment="CENTER" spacing="15" styleClass="formulario">

                <Label styleClass="titulo" text="Emprestimo" />

                <!-- Busca -->
                <VBox alignment="CENTER_LEFT" spacing="5" styleClass="campo">
                    <Label styleClass="label" text="Pesquisar Acervo:" />
                    <TextField fx:id="livroField" promptText="Digite o titulo" styleClass="input" />
                </VBox>

                <!-- Usuario -->
                <VBox alignment="CENTER_LEFT" spacing="5" styleClass="campo">
                    <Label styleClass="label" text="Membro:" />
                    <TextField fx:id="usuarioField" promptText="Membro logado" styleClass="input" />
                </VBox>

                <!-- Data emprestimo -->
                <VBox alignment="CENTER_LEFT" spacing="5" styleClass="campo">
                    <Label styleClass="label" text="Data Emprestimo:" />
                    <DatePicker fx:id="dataEmprestimo" styleClass="input" />
                </VBox>

                <!-- Data devolucao -->
                <VBox alignment="CENTER_LEFT" spacing="5" styleClass="campo">
                    <Label styleClass="label" text="Data Devolucao:" />
                    <DatePicker fx:id="dataDevolucao" styleClass="input" />
                </VBox>

                <!-- Botoes -->
                <Button onAction="#handleEmprestimo" styleClass="button-emprestimo" text="Registrar Emprestimo" />
                <Button onAction="#irParaDevolucao" styleClass="button-emprestimo" text="Ir para Devolucao" />
                <Button onAction="#irParaMenu" styleClass="button-emprestimo" text="Voltar ao Menu" />
            </VBox>

            <!-- LISTA -->
            <VBox alignment="CENTER" spacing="10" styleClass="lista-container">

                <Label styleClass="subtitulo" text="Itens Disponiveis">
                    <padding>
                        <Insets bottom="20.0" />
                    </padding>
                </Label>

                <ListView fx:id="listaAcervos" prefHeight="400" prefWidth="300" styleClass="lista-livros" />

            </VBox>

        </HBox>

    </center>

</BorderPane>
