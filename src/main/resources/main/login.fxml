<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aula.LoginController">

    <children>

        <VBox alignment="CENTER" spacing="20.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <children>

                <Label styleClass="label-campo" text="Usuário"/>
                <TextField fx:id="usuarioField" alignment="CENTER"
                           maxWidth="350.0"
                           promptText="Digite seu usuário"
                           styleClass="campo"/>

                <Label styleClass="label-campo" text="Senha"/>
                <PasswordField fx:id="senhaField" alignment="CENTER"
                               maxWidth="350.0"
                               promptText="Digite sua senha"
                               styleClass="campo"/>

                <!-- BOTÃO CORRIGIDO -->
                <Button text="Entrar"
                        fx:id="loginButton"
                        onAction="#fazerLogin"
                        styleClass="botao-login"/>

                <!-- MENSAGEM DE ERRO -->
                <Label fx:id="mensagem"
                       textFill="red"/>

                <Label fx:id="linkCadastro"
                       alignment="CENTER"
                       onMouseClicked="#linkCadastro"
                       styleClass="label-link"
                       text="Não tem conta? Cadastre-se aqui."/>

            </children>
        </VBox>

        <VBox alignment="CENTER"
              layoutX="403.0"
              layoutY="-10.0"
              prefHeight="78.0"
              prefWidth="179.0">

            <children>
                <Label text="Login" styleClass="titulo">
                    <font>
                        <Font size="24.0"/>
                    </font>
                </Label>
            </children>

        </VBox>

    </children>
</AnchorPane>