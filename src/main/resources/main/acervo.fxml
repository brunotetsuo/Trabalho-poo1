<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane prefWidth="1000.0" prefHeight="800.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aula.AcervoController"
            styleClass="root">

    <!-- TITULO -->
    <top>
        <Label text="Acervo"
               styleClass="titulo"
               BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" bottom="20"/>
            </padding>
        </Label>
    </top>

    <!-- CONTEUDO -->
    <center>

        <VBox alignment="CENTER" spacing="20">

            <!-- BUSCA -->
            <TextField fx:id="buscaField"
                       promptText="Pesquisar..."
                       onKeyReleased="#buscarLivro"
                       maxWidth="300"/>

            <!-- LISTA -->
            <ListView fx:id="listaAcervos"
                      prefWidth="400"
                      prefHeight="400"
                      styleClass="lista-livros"/>

            <!-- BOTAO -->
            <Button text="Selecionar"
                    onAction="#selecionarLivro"
                    styleClass="button-emprestimo"/>

        </VBox>

    </center>

</BorderPane>
